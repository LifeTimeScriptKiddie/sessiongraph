{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iseeagents.local/contracts/improvement-run.v1.schema.json",
  "title": "Controller-neutral graph engineering experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "objective", "baseline", "candidate", "measures", "acceptance", "stopConditions"],
  "properties": {
    "schemaVersion": { "const": "iseeagents.improvement-run.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "controller": {
      "type": ["object", "null"],
      "description": "Optional controller metadata; agentctl is supported but never required.",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "baseline": { "$ref": "#/$defs/condition" },
    "candidate": { "$ref": "#/$defs/condition" },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["increase", "decrease", "hold", "descriptive"] },
          "unit": { "type": ["string", "null"] }
        }
      }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": ["string", "null"] }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "taskSet", "trials"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "taskSet": { "type": "string", "minLength": 1 },
        "trials": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
